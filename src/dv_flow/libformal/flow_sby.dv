
package:
  name: formal.sby

  tasks:
  - name: BMC
    consumes:
    - {filetype: systemVerilogSource }
    - {filetype: verilogSource }
    # A formal proof is a RUN, not a build artifact -- always re-execute, exactly
    # like hdlsim.SimRun. A cached "PASS" must never stand in for an actual run
    # after a source change. Input FileSets remain content-hashed as normal.
    uptodate: false
    shell: pytask
    run: dv_flow.libformal.sby_bmc.BMC
    with:
      top:
        type: str
      depth:
        type: int
        value: 20

  # Cover (reachability / non-vacuity): find a trace reaching every cover()
  # statement within `depth`; FAILS if any cover is unreachable. Complements BMC,
  # which proves asserts but ignores covers. Same inputs/params as BMC.
  - name: Cover
    consumes:
    - {filetype: systemVerilogSource }
    - {filetype: verilogSource }
    uptodate: false
    shell: pytask
    run: dv_flow.libformal.sby_bmc.Cover
    with:
      top:
        type: str
      depth:
        type: int
        value: 20
