
package:
  name: formal.sby

  # hdlsim.TestResult is the verdict type hdlsim.SimSuiteReport (and so a
  # project's `tests`) rolls up; Case emits it.
  imports:
  - name: hdlsim

  tasks:
  - name: BMC
    consumes:
    - {filetype: systemVerilogSource }
    - {filetype: verilogSource }
    # A formal proof is a RUN, not a build artifact -- always re-execute, exactly
    # like hdlsim.SimRun. A cached "PASS" must never stand in for an actual run
    # after a source change. Input FileSets remain content-hashed as normal.
    uptodate: false
    shell: pytask
    run: dv_flow.libformal.sby_bmc.BMC
    with:
      top:
        type: str
      depth:
        type: int
        value: 20

  # Cover (reachability / non-vacuity): find a trace reaching every cover()
  # statement within `depth`; FAILS if any cover is unreachable. Complements BMC,
  # which proves asserts but ignores covers. Same inputs/params as BMC.
  - name: Cover
    consumes:
    - {filetype: systemVerilogSource }
    - {filetype: verilogSource }
    uptodate: false
    shell: pytask
    run: dv_flow.libformal.sby_bmc.Cover
    with:
      top:
        type: str
      depth:
        type: int
        value: 20


  # Case: one proof as a TEST CASE -- the sby verdict becomes an
  # hdlsim.TestResult and the task succeeds whatever the verdict, so it sits in
  # a suite matrix under hdlsim.SimSuiteReport / a project's `tests` exactly
  # like a simulation case. BMC and Cover above stay as they are: a failing
  # proof fails the task.
  - name: Case
    consumes:
    - {filetype: systemVerilogSource }
    - {filetype: verilogSource }
    uptodate: false
    shell: pytask
    run: dv_flow.libformal.sby_bmc.Case
    produces:
    - type: hdlsim.TestResult
      name: "${{ name }}"
    with:
      name:
        doc: Case name for the TestResult (defaults to the task name)
        type: str
        value: ""
      top:
        type: str
      mode:
        doc: "sby mode: bmc (asserts to depth), cover (every cover reachable), prove (unbounded, k-induction)"
        type: str
        value: bmc
      depth:
        type: int
        value: 20
